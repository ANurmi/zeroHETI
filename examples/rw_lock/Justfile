runtime_ms := "20"
fmutex := "ui-test/run-mutex.stdout"
frw := "ui-test/run-rw.stdout"

run-mutex:
    echo "== mutex build =="
    stdbuf -oL cargo run --release -Frtl-tb,intc-clic

run-rw:
    echo "== rw-lock build =="
    stdbuf -oL cargo run --release -Frtl-tb,intc-clic,rw

compare:
    mkdir -p ui-test
    @: > {{ fmutex }}
    RUNTIME_MS={{ runtime_ms }} stdbuf -oL cargo run --release -Frtl-tb,intc-clic \
        | tee {{ fmutex }}
    RUNTIME_MS={{ runtime_ms }} stdbuf -oL cargo run --release -Frtl-tb,intc-clic,rw \
        | tee {{ frw }}
    echo ""
    echo "=== side-by-side ==="
    paste <(grep -E "worst|VERDICT" {{ fmutex }}) \
          <(grep -E "worst|VERDICT" {{ frw }}) \
        | column -t -s $'\t'

csv:
    mkdir -p ui-test
    python3 parse.py {{ fmutex }} ui-test/mutex.csv
    python3 parse.py {{ frw }} ui-test/rw.csv

plots: csv
    typst compile plots.typ ui-test/plots.svg
    echo "ui-test/plots.svg written"
