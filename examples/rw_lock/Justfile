runtime_ms := "3"
fmutex := "ui-test/run-mutex.stdout"
frw := "ui-test/run-rw.stdout"
trace_range := "/\\[obs\\] \\[TRACE_START\\]/,/\\[obs\\] \\[TRACE_END\\]/"

run features='':
    @echo "extra params: {{ features }}"
    RUNTIME_MS={{ runtime_ms }} stdbuf -oL cargo run --release -Frtl-tb,intc-clic {{ features }}

trace features='':
    just run -Fobs {{ features }} | sed -n '{{ trace_range }}{ /TRACE_START/d; /TRACE_END/d; p; }'

trace-mutex:
    bash -c 'RUNTIME_MS={{ runtime_ms }} stdbuf -oL cargo run --release -Frtl-tb,intc-clic,obs \
        | tee >(stdbuf -oL sed -n "{{ trace_range }}{ /TRACE_START/d; /TRACE_END/d; p; }" > ui-test/mutex.trace) \
        | stdbuf -oL sed "{{ trace_range }}d"'
    uv run trace_to_csv_ceil.py ui-test/mutex.trace ui-test/ceil-mutex.csv
    uv run trace_to_csv_exec.py ui-test/mutex.trace ui-test/exec-mutex.csv

trace-rw:
    bash -c 'RUNTIME_MS={{ runtime_ms }} stdbuf -oL cargo run --release -Frtl-tb,intc-clic,obs,rw \
        | tee >(stdbuf -oL sed -n "{{ trace_range }}{ /TRACE_START/d; /TRACE_END/d; p; }" > ui-test/rw.trace) \
        | stdbuf -oL sed "{{ trace_range }}d"'
    uv run trace_to_csv_ceil.py ui-test/rw.trace ui-test/ceil-rw.csv
    uv run trace_to_csv_exec.py ui-test/rw.trace ui-test/exec-rw.csv

trace-both:
    just trace-mutex
    just trace-rw

compare:
    mkdir -p ui-test
    @: > {{ fmutex }}
    RUNTIME_MS={{ runtime_ms }} stdbuf -oL cargo run --release -Frtl-tb,intc-clic \
        | tee {{ fmutex }}
    RUNTIME_MS={{ runtime_ms }} stdbuf -oL cargo run --release -Frtl-tb,intc-clic,rw \
        | tee {{ frw }}
    echo ""
    echo "=== side-by-side ==="
    paste <(grep -E "worst|VERDICT" {{ fmutex }}) <(grep -E "worst|VERDICT" {{ frw }}) | column -t -s $'\t'
